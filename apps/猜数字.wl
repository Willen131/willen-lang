# 猜数字游戏
# 程序先随机生成一个 1 到 100 的目标数，然后不断让玩家猜测，
# 每次给出「大了」「小了」的提示，猜中后统计并输出猜测次数。

# 判断一个字符串是否全部由数字字符组成。
# 因为 整数() 遇到非数字内容会直接报错，所以必须先自行检查。
函数 是数字串(甲) {
    如果 (长度(甲) == 0) { 返回 假 }
    设 数字表 = "0123456789"
    设 游标 = 0
    当 (游标 < 长度(甲)) {
        如果 (非 数字表.包含(甲.字符(游标))) {
            返回 假
        }
        游标 = 游标 + 1
    }
    返回 真
}

# 随机数两端都包含，所以 随机数(1, 100) 就是 1 到 100 之间的整数
设 目标 = 随机数(1, 100)

# 有效猜测次数，非法输入不计入
设 次数 = 0

# 主循环：反复提示输入，直到猜中才跳出
当 (真) {
    设 行 = 输入("请输入 1-100 的数字：")

    # 去掉首尾空白，避免玩家多打了空格导致误判
    设 文本 = 行.去空白()

    # 情况一：不是纯数字，提示后重新输入，次数不增加
    如果 (非 是数字串(文本)) {
        打印("输入的不是数字，请重新输入")
        继续
    }

    设 猜 = 整数(文本)

    # 情况二：数字超出了 1 到 100 的范围，同样视为无效输入
    如果 (猜 < 1 或 猜 > 100) {
        打印("数字超出范围，请输入 1-100 的数字")
        继续
    }

    # 到这里才算一次有效猜测
    次数 = 次数 + 1

    如果 (猜 > 目标) {
        打印("大了")
    } 否则如果 (猜 < 目标) {
        打印("小了")
    } 否则 {
        打印("猜中了！")
        跳出
    }
}

# 猜中后结束，输出总次数
打印("你一共猜了 {次数} 次")
