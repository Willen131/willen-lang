# ============================================================
# 迷宫生成与求解
#   生成：递归回溯法（深度优先搜索挖通路）
#   求解：广度优先搜索求最短路径
#   随机：自实现线性同余发生器，固定种子，结果可复现
#   渲染：墙 █   通路（空格）   路径 ·   起点 起   终点 终
# ============================================================

# ------------------------------------------------------------
# 全局常量
#   迷宫逻辑上是 12 × 12 个单元格
#   用 (2*12+1) × (2*12+1) 的网格表示：
#     偶数下标是墙，奇数下标是单元格
# ------------------------------------------------------------
设 格子数 = 12
设 边长 = 格子数 * 2 + 1
设 种子 = 12345

# ------------------------------------------------------------
# 线性同余随机数发生器（自己实现，固定种子，结果可复现）
#   递推式：状态 = (状态 * 25173 + 13849) % 65521
#   状态放在单元素数组里传入，利用数组的引用语义在函数间共享，
#   这样就不依赖任何全局可变变量。
#   中间乘积最大约 6.5 万 × 2.5 万 ≈ 16.5 亿，不超出 32 位范围。
# ------------------------------------------------------------
函数 取随机(状态, 上界) {
    状态[0] = (状态[0] * 25173 + 13849) % 65521
    返回 状态[0] % 上界
}

# ------------------------------------------------------------
# 原地洗牌（Fisher-Yates 的简化版）
#   交换若干次，打乱一个数列的顺序
# ------------------------------------------------------------
函数 洗牌(数列, 状态, 次数) {
    设 下 = 0
    当 (下 < 次数) {
        设 甲 = 取随机(状态, 长度(数列))
        设 乙 = 取随机(状态, 长度(数列))
        设 暂 = 数列[甲]
        数列[甲] = 数列[乙]
        数列[乙] = 暂
        下 = 下 + 1
    }
}

# ------------------------------------------------------------
# 建立二维数组（行数 × 列数），全部填同一个初值
#   注意：每一行都必须新建数组，不能共享同一行，
#   否则改动一行会波及其它行（数组是引用语义）。
# ------------------------------------------------------------
函数 建网格(行数, 列数, 初值) {
    设 网格 = []
    设 行 = 0
    当 (行 < 行数) {
        设 一维 = []
        设 列 = 0
        当 (列 < 列数) {
            一维.追加(初值)
            列 = 列 + 1
        }
        网格.追加(一维)
        行 = 行 + 1
    }
    返回 网格
}

# ------------------------------------------------------------
# 方向编码 0=上  1=右  2=下  3=左
#   返回 [行增量, 列增量]，增量为 2 是因为两格之间隔着一堵墙
# ------------------------------------------------------------
函数 取偏移(方向) {
    如果 (方向 == 0) { 返回 [-2, 0] }
    如果 (方向 == 1) { 返回 [0, 2] }
    如果 (方向 == 2) { 返回 [2, 0] }
    返回 [0, -2]
}

# ------------------------------------------------------------
# 递归回溯挖迷宫
#   从单元格 (行, 列) 出发（行列都是奇数下标）：
#     1. 把当前格标成通路
#     2. 随机打乱四个方向
#     3. 依次看向该方向两步的邻居是否越界、是否还没挖过
#     4. 若可挖，就把中间那堵墙打通，再递归进去
#   递归深度最大约为单元格总数（144），低于语言 200 层上限。
# ------------------------------------------------------------
函数 挖迷宫(网格, 行, 列, 状态) {
    网格[行][列] = 1
    设 方向 = [0, 1, 2, 3]
    洗牌(方向, 状态, 8)
    设 序号 = 0
    当 (序号 < 4) {
        设 偏移 = 取偏移(方向[序号])
        设 新行 = 行 + 偏移[0]
        设 新列 = 列 + 偏移[1]
        设 行合法 = (新行 >= 1) 且 (新行 <= 边长 - 2)
        设 列合法 = (新列 >= 1) 且 (新列 <= 边长 - 2)
        如果 (行合法 且 列合法) {
            如果 (网格[新行][新列] == 0) {
                设 墙行 = 行 + 偏移[0] / 2
                设 墙列 = 列 + 偏移[1] / 2
                网格[墙行][墙列] = 1
                挖迷宫(网格, 新行, 新列, 状态)
            }
        }
        序号 = 序号 + 1
    }
}

# ------------------------------------------------------------
# 广度优先搜索求最短路径
#   网格里 1 是通路、0 是墙
#   访问数组记录是否入过队；前驱数组记录每个点从哪来，
#   用 行 * 边长 + 列 把坐标压成一个整数存起来，便于回溯。
#   返回：路径数组，元素是 [行, 列]，按起点到终点顺序排列。
# ------------------------------------------------------------
函数 求路径(网格, 起行, 起列, 终行, 终列) {
    设 前驱 = 建网格(边长, 边长, -1)
    设 访问 = 建网格(边长, 边长, 0)
    设 队列 = []
    队列.追加([起行, 起列])
    访问[起行][起列] = 1
    设 步 = [[-1, 0], [1, 0], [0, -1], [0, 1]]
    设 头 = 0
    当 (头 < 长度(队列)) {
        设 当前 = 队列[头]
        头 = 头 + 1
        设 行 = 当前[0]
        设 列 = 当前[1]
        如果 ((行 == 终行) 且 (列 == 终列)) { 跳出 }
        设 序 = 0
        当 (序 < 4) {
            设 新行 = 行 + 步[序][0]
            设 新列 = 列 + 步[序][1]
            设 范围内 = (新行 >= 0) 且 (新行 < 边长) 且 (新列 >= 0) 且 (新列 < 边长)
            如果 (范围内) {
                设 是通路 = 网格[新行][新列] == 1
                设 没来过 = 访问[新行][新列] == 0
                如果 (是通路 且 没来过) {
                    访问[新行][新列] = 1
                    前驱[新行][新列] = 行 * 边长 + 列
                    队列.追加([新行, 新列])
                }
            }
            序 = 序 + 1
        }
    }
    设 路径 = []
    如果 (访问[终行][终列] == 0) { 返回 路径 }
    设 行 = 终行
    设 列 = 终列
    当 (非 ((行 == 起行) 且 (列 == 起列))) {
        路径.追加([行, 列])
        设 编号 = 前驱[行][列]
        行 = 编号 / 边长
        列 = 编号 % 边长
    }
    路径.追加([起行, 起列])
    路径.反转()
    返回 路径
}

# ------------------------------------------------------------
# 把路径经过的坐标打上标记，方便渲染时区分
# ------------------------------------------------------------
函数 建标记(路径) {
    设 标记 = 建网格(边长, 边长, 0)
    遍历 (点 在 路径) {
        标记[点[0]][点[1]] = 1
    }
    返回 标记
}

# ------------------------------------------------------------
# 字符画渲染
#   墙 █   通路（空格）   路径 ·   起点 起   终点 终
#   逐行拼好一串字符再整行打印，避免空打印带来的排版问题。
# ------------------------------------------------------------
函数 渲染(网格, 标记) {
    设 行 = 0
    当 (行 < 边长) {
        设 单元 = []
        设 列 = 0
        当 (列 < 边长) {
            设 符号 = "█"
            如果 (网格[行][列] == 1) {
                符号 = " "
                如果 (标记[行][列] == 1) { 符号 = "·" }
            }
            如果 ((行 == 1) 且 (列 == 1)) { 符号 = "起" }
            如果 ((行 == 边长 - 2) 且 (列 == 边长 - 2)) { 符号 = "终" }
            单元.追加(符号)
            列 = 列 + 1
        }
        打印(单元.连接(""))
        行 = 行 + 1
    }
}

# ------------------------------------------------------------
# 主流程
# ------------------------------------------------------------
设 网格 = 建网格(边长, 边长, 0)
设 状态 = [种子]

# 第一步：递归回溯生成迷宫
挖迷宫(网格, 1, 1, 状态)

# 第二步：广度优先搜索求从左上角到右下角的最短路径
设 终点 = 边长 - 2
设 路径 = 求路径(网格, 1, 1, 终点, 终点)
设 标记 = 建标记(路径)

# 第三步：输出结果
打印("迷宫尺寸：{格子数} × {格子数} 单元格（字符网格 {边长} × {边长}）")
打印("最短路径步数：{长度(路径) - 1} 步")
打印("")
渲染(网格, 标记)
