# ============================================================
# 迷宫生成与求解
# 语言：Willen（中文关键字的类 C 脚本语言）
# 算法：用「递归回溯法」（深度优先搜索）随机生成迷宫，
#       再用广度优先搜索求左上角到右下角的最短路径。
# ============================================================


# ------------------------------------------------------------
# 一、顶层常量与随机数状态
# ------------------------------------------------------------

# 迷宫每边的单元格个数。
# 只需要改动这一个数字，就能整体放大或缩小迷宫规模。
常量 格子数 = 12

# 线性同余随机数生成器的种子。
# 放在顶层变量里，保证每次运行都得到完全相同的迷宫，结果可复现。
设 随机种子 = 20240607

# 生成器的内部状态，运行过程中会被不断改写。
设 随机状态 = 随机种子


# ------------------------------------------------------------
# 二、自己实现的线性同余随机数生成器（LCG）
# ------------------------------------------------------------

# 返回一个 [0, 上界) 范围内的非负整数。
# 递推式：x = (a * x + c) mod m，其中
#   a = 1103515245, c = 12345, m = 2 的 31 次方（2147483648）。
# 所有运算都在 64 位整数范围内，不会溢出。
函数 取随机(上界) {
    # 先推进一次状态
    随机状态 = (随机状态 * 1103515245 + 12345) % 2147483648
    # 取结果的高位再做一次取模，让分布更均匀一些
    设 结果 = (随机状态 / 65536) % 上界
    返回 结果
}


# ------------------------------------------------------------
# 三、二维网格的构造工具
# ------------------------------------------------------------

# 创建一个 尺寸 × 尺寸 的二维网格，每个格子填满 初值。
# 注意：程序里每一行都是一个独立创建的数组，
#       因此修改某一行不会意外影响到别的行。
函数 建网格(尺寸, 初值) {
    设 网格 = []
    遍历 (行 在 0..(尺寸 - 1)) {
        设 一行 = []
        遍历 (列 在 0..(尺寸 - 1)) {
            一行.追加(初值)
        }
        网格.追加(一行)
    }
    返回 网格
}

# 创建初值全为「假」的布尔二维网格，用作访问标记。
函数 建布尔网格(尺寸) {
    返回 建网格(尺寸, 假)
}

# 创建初值可指定的整数二维网格。
函数 建整数网格(尺寸, 初值) {
    返回 建网格(尺寸, 初值)
}

# 创建迷宫墙体网格：先用 1（代表墙）填满，随后再逐一打通。
函数 建墙体网格(尺寸) {
    返回 建网格(尺寸, 1)
}


# ------------------------------------------------------------
# 四、用递归回溯法生成迷宫（改用显式栈迭代实现）
# ------------------------------------------------------------
# 网格坐标约定：
#   偶数下标所在的位置是墙，奇数下标所在的位置是单元格。
#   第「行、列」个单元格的中心位于 (2*行+1, 2*列+1)。
#   两个相邻单元格之间的那面墙，位于它们的正中间。
#
# 回溯法流程：
#   1. 从左上角单元格出发，把它标记为已访问；
#   2. 如果当前位置还有未访问的邻居：随机挑一个，
#      打通两者之间的墙，走到新单元格并把新位置入栈；
#   3. 如果没有未访问的邻居：弹栈，退回到上一个位置（回溯）；
#   4. 栈空了，说明所有单元格都已访问完毕。
#
# 为什么用显式栈，而不用函数递归？
# 语言规定递归深度不能超过 200 层。当格子数 = 12 时，
# 单元格共有 12 × 12 = 144 个，递归版本最坏要压到 144 层，
# 一旦把格子数调大一点就会越界报错。显式栈版本没有这个隐患，
# 算法本身与递归写法完全等价。
函数 生成迷宫(网格, n) {
    # 访问标记表，初始全部为「假」
    设 访问 = 建布尔网格(n)
    # 显式栈：栈里保存的是「编码后的单元格坐标」
    # 编码规则：编码 = 行 * n + 列
    # 解码规则：行 = 编码 / n     列 = 编码 % n
    设 栈 = []
    # 起点固定为左上角单元格 (0, 0)，它的编码正好是 0
    访问[0][0] = 真
    网格[1][1] = 0
    栈.追加(0)
    # 只要栈不为空，就继续探索
    当 (长度(栈) > 0) {
        # 读取栈顶元素，但先不弹出
        设 顶 = 栈[长度(栈) - 1]
        设 行 = 顶 / n
        设 列 = 顶 % n
        # 收集所有「尚未访问」的邻居单元格的编码
        设 邻居 = []
        如果 (行 > 0) {
            如果 (非 访问[行 - 1][列]) {
                邻居.追加((行 - 1) * n + 列)
            }
        }
        如果 (行 < n - 1) {
            如果 (非 访问[行 + 1][列]) {
                邻居.追加((行 + 1) * n + 列)
            }
        }
        如果 (列 > 0) {
            如果 (非 访问[行][列 - 1]) {
                邻居.追加(行 * n + (列 - 1))
            }
        }
        如果 (列 < n - 1) {
            如果 (非 访问[行][列 + 1]) {
                邻居.追加(行 * n + 列 + 1)
            }
        }
        如果 (长度(邻居) == 0) {
            # 四面都走不通了，弹栈回溯
            栈.弹()
        } 否则 {
            # 从可走的邻居里随机挑一个
            设 选 = 邻居[取随机(长度(邻居))]
            设 新行 = 选 / n
            设 新列 = 选 % n
            # 打通「当前单元格」与「新单元格」之间的那面墙
            # 它位于两个单元格中心的中点：
            设 墙行 = 2 * 行 + 1 + (新行 - 行)
            设 墙列 = 2 * 列 + 1 + (新列 - 列)
            网格[墙行][墙列] = 0
            # 新单元格本身也要打通
            网格[2 * 新行 + 1][2 * 新列 + 1] = 0
            # 标记为已访问，并把新位置压栈
            访问[新行][新列] = 真
            栈.追加(选)
        }
    }
}


# ------------------------------------------------------------
# 五、广度优先搜索求最短路径
# ------------------------------------------------------------
# 输入：墙体网格与单元格边长 n；输出：一个编码坐标数组，
#       从起点 (1,1) 到终点 (尺寸-2, 尺寸-2) 依次排列。
# 广度优先搜索保证它在无权图上找到的第一条路径就是最短路径。
函数 求最短路径(网格, n) {
    设 尺寸 = 2 * n + 1
    # 记录某个格子是否已经被发现（即已经入过队）
    设 见过 = 建布尔网格(尺寸)
    # 记录每个格子的前驱编码，-1 表示暂时还没有前驱
    设 前驱 = 建整数网格(尺寸, -1)
    # 直接用数组当作队列，用头指针 头 控制出队位置
    设 队列 = []
    设 起点 = 1 * 尺寸 + 1
    设 终点 = (尺寸 - 2) * 尺寸 + (尺寸 - 2)
    见过[1][1] = 真
    队列.追加(起点)
    设 头 = 0
    设 到达 = 假
    # 队列未空，并且还没到达终点时，继续搜索
    当 (头 < 长度(队列)) {
        设 当前 = 队列[头]
        头 = 头 + 1
        设 行 = 当前 / 尺寸
        设 列 = 当前 % 尺寸
        # 一旦弹出终点，就可以停止搜索
        如果 (当前 == 终点) {
            到达 = 真
            跳出
        }
        # 依次检查上下左右四个方向
        # 只有「是通路」且「没被见过」的格子才允许入队
        如果 (行 > 0) {
            如果 (网格[行 - 1][列] == 0 且 非 见过[行 - 1][列]) {
                见过[行 - 1][列] = 真
                前驱[行 - 1][列] = 当前
                队列.追加(当前 - 尺寸)
            }
        }
        如果 (行 < 尺寸 - 1) {
            如果 (网格[行 + 1][列] == 0 且 非 见过[行 + 1][列]) {
                见过[行 + 1][列] = 真
                前驱[行 + 1][列] = 当前
                队列.追加(当前 + 尺寸)
            }
        }
        如果 (列 > 0) {
            如果 (网格[行][列 - 1] == 0 且 非 见过[行][列 - 1]) {
                见过[行][列 - 1] = 真
                前驱[行][列 - 1] = 当前
                队列.追加(当前 - 1)
            }
        }
        如果 (列 < 尺寸 - 1) {
            如果 (网格[行][列 + 1] == 0 且 非 见过[行][列 + 1]) {
                见过[行][列 + 1] = 真
                前驱[行][列 + 1] = 当前
                队列.追加(当前 + 1)
            }
        }
    }
    # 理论上迷宫一定连通，不会走到这里；留作保险
    如果 (非 到达) {
        返回 []
    }
    # 从终点沿着前驱一路回溯到起点，再整体反转
    设 路径 = []
    设 游标 = 终点
    当 (真) {
        路径.追加(游标)
        如果 (游标 == 起点) {
            跳出
        }
        设 父 = 前驱[游标 / 尺寸][游标 % 尺寸]
        游标 = 父
    }
    路径.反转()
    返回 路径
}


# ------------------------------------------------------------
# 六、统计信息
# ------------------------------------------------------------

# 统计整个网格里所有「通路」（值为 0）的格子数量。
# 注意：遍历二维数组时，遍历变量拿到的是「一行」（一维数组）。
函数 数通路(网格) {
    设 计数 = 0
    遍历 (行 在 网格) {
        遍历 (元 在 行) {
            如果 (元 == 0) {
                计数 = 计数 + 1
            }
        }
    }
    返回 计数
}

# 生成一条指定宽度的横线，用来分隔输出。
函数 画横线(宽度) {
    设 线 = ""
    重复 宽度 次 {
        线 = 线 + "─"
    }
    返回 线
}


# ------------------------------------------------------------
# 七、字符画渲染
# ------------------------------------------------------------
# 模式 1：完整迷宫——墙画成实心块，通路留空，路径画点，并标出起终点；
# 模式 2：只看路径——墙与没走过的通路都留空，只画路径本身，
#         这样路径的走向一眼就能看清楚。
函数 渲染迷宫(网格, n, 路径, 模式) {
    设 尺寸 = 2 * n + 1
    # 先把路径经过的格子标记出来，方便后面逐格判断
    设 在路径上 = 建布尔网格(尺寸)
    遍历 (编码 在 路径) {
        设 路径行 = 编码 / 尺寸
        设 路径列 = 编码 % 尺寸
        在路径上[路径行][路径列] = 真
    }
    # 起点与终点的网格坐标
    设 起行 = 1
    设 起列 = 1
    设 终行 = 尺寸 - 2
    设 终列 = 尺寸 - 2
    # 逐行拼接字符串，最后整行打印，避免一个字符换一次行
    遍历 (行 在 0..(尺寸 - 1)) {
        设 行串 = ""
        遍历 (列 在 0..(尺寸 - 1)) {
            如果 (行 == 起行 且 列 == 起列) {
                # 起点
                行串 = 行串 + "起"
            } 否则如果 (行 == 终行 且 列 == 终列) {
                # 终点
                行串 = 行串 + "终"
            } 否则如果 (在路径上[行][列]) {
                # 路径经过的格子
                行串 = 行串 + "·"
            } 否则如果 (模式 == 1 且 网格[行][列] == 1) {
                # 模式 1 才画墙
                行串 = 行串 + "█"
            } 否则 {
                # 其余一律留空（空格）
                行串 = 行串 + " "
            }
        }
        打印(行串)
    }
}


# ------------------------------------------------------------
# 八、主流程
# ------------------------------------------------------------

# 网格边长：2 * 格子数 + 1
设 尺寸 = 2 * 格子数 + 1

# 先建出全是墙的网格，再用回溯法打通通道
设 网格 = 建墙体网格(尺寸)
生成迷宫(网格, 格子数)

# 用广度优先搜索求解最短路径
设 路径 = 求最短路径(网格, 格子数)

# 打印统计信息
设 横线 = 画横线(尺寸 * 2)
打印(横线)
打印("迷宫统计")
打印(横线)
打印("单元格规模：{格子数} × {格子数}")
打印("网格边长：{尺寸} × {尺寸}")
打印("通路格数：{数通路(网格)}")
打印("最短路径长度：{长度(路径)} 格")
打印(横线)

# 第一种渲染：完整迷宫
打印("")
打印("【模式一】完整迷宫（█ = 墙，· = 路径，起 / 终 = 端点）")
打印("")
渲染迷宫(网格, 格子数, 路径, 1)

# 第二种渲染：只画路径
打印("")
打印("【模式二】只看路径（隐去墙体，路径走向一目了然）")
打印("")
渲染迷宫(网格, 格子数, 路径, 2)

# 收尾分隔
打印("")
打印(横线)
