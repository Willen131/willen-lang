# 性能基准：迷宫生成与求解
#
# 40x40 单元格的完美迷宫：迭代式深度优先回溯生成，
# 再用广度优先搜索求从左上角到右下角的最短路。
# Python 对照脚本见 maze.py，两者算法与随机序列完全一致。
#
# 注意：生成用显式栈而非递归——40x40 的 DFS 深度会超过
# Willen 的 200 层递归上限。

设 单元格宽 = 40
设 单元格高 = 40
设 宽 = 单元格宽 * 2 + 1
设 高 = 单元格高 * 2 + 1

# 固定种子的线性同余生成器，保证两语言生成同一座迷宫
设 种子 = 98765
函数 下一个随机() {
    种子 = (种子 * 1103515245 + 12345) % 2147483648
    返回 种子
}

# 方向表：上、下、左、右，步长 2（跨过一个单元格）
设 方向横 = [0, 0, -2, 2]
设 方向纵 = [-2, 2, 0, 0]

# ---- 初始化：全部是墙（1 表示墙，0 表示通路）----
设 迷宫 = []
设 纵 = 0
当 (纵 < 高) {
    设 行 = []
    设 横 = 0
    当 (横 < 宽) {
        行.追加(1)
        横 = 横 + 1
    }
    迷宫.追加(行)
    纵 = 纵 + 1
}

# ---- 迭代式深度优先回溯，挖出通道 ----
迷宫[1][1] = 0
设 栈横 = [1]
设 栈纵 = [1]

当 (长度(栈横) > 0) {
    设 顶 = 长度(栈横) - 1
    设 横 = 栈横[顶]
    设 纵 = 栈纵[顶]

    # 收集相邻的未访问单元格
    设 候选 = []
    设 序 = 0
    当 (序 < 4) {
        设 新横 = 横 + 方向横[序]
        设 新纵 = 纵 + 方向纵[序]
        如果 (新横 > 0 且 新横 < 宽 - 1 且 新纵 > 0 且 新纵 < 高 - 1) {
            如果 (迷宫[新纵][新横] == 1) { 候选.追加(序) }
        }
        序 = 序 + 1
    }

    如果 (长度(候选) == 0) {
        # 没有未访问的邻居，回溯
        栈横.弹()
        栈纵.弹()
    } 否则 {
        设 方向 = 候选[下一个随机() % 长度(候选)]
        设 新横 = 横 + 方向横[方向]
        设 新纵 = 纵 + 方向纵[方向]
        # 打通当前格与新格之间的那面墙
        迷宫[纵 + 方向纵[方向] / 2][横 + 方向横[方向] / 2] = 0
        迷宫[新纵][新横] = 0
        栈横.追加(新横)
        栈纵.追加(新纵)
    }
}

# ---- 广度优先搜索求最短路 ----
设 距离 = []
纵 = 0
当 (纵 < 高) {
    设 行 = []
    设 横 = 0
    当 (横 < 宽) {
        行.追加(-1)
        横 = 横 + 1
    }
    距离.追加(行)
    纵 = 纵 + 1
}

设 队列横 = [1]
设 队列纵 = [1]
设 头 = 0
距离[1][1] = 0

# 四邻域，步长 1
设 步横 = [0, 0, -1, 1]
设 步纵 = [-1, 1, 0, 0]

当 (头 < 长度(队列横)) {
    设 横 = 队列横[头]
    设 纵 = 队列纵[头]
    头 = 头 + 1

    设 序 = 0
    当 (序 < 4) {
        设 新横 = 横 + 步横[序]
        设 新纵 = 纵 + 步纵[序]
        如果 (新横 >= 0 且 新横 < 宽 且 新纵 >= 0 且 新纵 < 高) {
            如果 (迷宫[新纵][新横] == 0 且 距离[新纵][新横] < 0) {
                距离[新纵][新横] = 距离[纵][横] + 1
                队列横.追加(新横)
                队列纵.追加(新纵)
            }
        }
        序 = 序 + 1
    }
}

# 输出通路总数与最短路长度作为校验
设 通路数 = 0
纵 = 0
当 (纵 < 高) {
    设 横 = 0
    当 (横 < 宽) {
        如果 (迷宫[纵][横] == 0) { 通路数 = 通路数 + 1 }
        横 = 横 + 1
    }
    纵 = 纵 + 1
}

打印(通路数)
打印(距离[高 - 2][宽 - 2])
