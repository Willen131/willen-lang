# 性能基准：冒泡排序一万个元素
#
# 考察数组下标读写。两语言使用完全相同的线性同余生成器，
# 保证排序的是同一组数字，结果可直接比对。

设 数量 = 2000

# 固定种子的线性同余生成器
设 种子 = 12345
设 数据 = []
设 序 = 0
当 (序 < 数量) {
    种子 = (种子 * 1103515245 + 12345) % 2147483648
    数据.追加(种子 % 100000)
    序 = 序 + 1
}

# 冒泡排序
设 轮 = 0
当 (轮 < 数量 - 1) {
    设 位 = 0
    当 (位 < 数量 - 1 - 轮) {
        如果 (数据[位] > 数据[位+1]) {
            设 暂 = 数据[位]
            数据[位] = 数据[位+1]
            数据[位+1] = 暂
        }
        位 = 位 + 1
    }
    轮 = 轮 + 1
}

# 输出首、中、末三个值作为正确性校验
打印(数据[0])
打印(数据[数量 / 2])
打印(数据[数量 - 1])
