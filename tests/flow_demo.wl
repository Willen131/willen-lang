# 控制流与函数测试
函数 斐波那契(甲) {
    如果 (甲 < 2) { 返回 甲 }
    返回 斐波那契(甲-1) + 斐波那契(甲-2)
}
打印(斐波那契(10))

函数 阶乘(甲) {
    如果 (甲 <= 1) { 返回 1 }
    返回 甲 * 阶乘(甲-1)
}
打印(阶乘(5))

函数 求和(甲, 乙) { 返回 甲 + 乙 }
打印(求和(3, 4))

设 计数 = 0
当 (计数 < 3) {
    计数 = 计数 + 1
}
打印(计数)

设 累计 = 0
遍历 (元 在 0..4) {
    累计 = 累计 + 元
}
打印(累计)

设 星 = ""
重复 3 次 {
    星 = 星 + "*"
}
打印(星)

设 找到 = 0
遍历 (元 在 0..9) {
    如果 (元 == 5) { 跳出 }
    找到 = 找到 + 1
}
打印(找到)

设 偶数和 = 0
遍历 (元 在 0..9) {
    如果 (元 % 2 != 0) { 继续 }
    偶数和 = 偶数和 + 元
}
打印(偶数和)

设 甲 = 1
{
    设 甲 = 2
    打印(甲)
}
打印(甲)

函数 改首项(数列) {
    数列[0] = 99
}
设 数据 = [1, 2]
改首项(数据)
打印(数据)

函数 汉诺塔(层数, 甲柱, 乙柱, 丙柱) {
    如果 (层数 == 0) { 返回 }
    汉诺塔(层数 - 1, 甲柱, 丙柱, 乙柱)
    打印(甲柱 + "->" + 乙柱)
    汉诺塔(层数 - 1, 丙柱, 乙柱, 甲柱)
}
汉诺塔(3, "A", "B", "C")

遍历 (左 在 1..3) {
    设 行 = ""
    设 首 = 真
    遍历 (右 在 1..左) {
        如果 (非 首) { 行 = 行 + " " }
        行 = 行 + 左 + "×" + 右 + "=" + 左 * 右
        首 = 假
    }
    打印(行)
}
