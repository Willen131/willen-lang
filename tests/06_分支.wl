# 06 分支

# ---- 如果 ----
设 结果 = ""
如果 (真) { 结果 = "真分支" }
断言等于(结果, "真分支", "条件为真走真分支")

结果 = ""
如果 (假) { 结果 = "真分支" }
断言等于(结果, "", "条件为假不执行")

# ---- 如果 / 否则 ----
结果 = ""
如果 (假) { 结果 = "甲" } 否则 { 结果 = "乙" }
断言等于(结果, "乙", "条件为假走否则分支")

结果 = ""
如果 (真) { 结果 = "甲" } 否则 { 结果 = "乙" }
断言等于(结果, "甲", "条件为真不走否则分支")

# ---- 否则如果 链 ----
函数 评级(分数) {
    如果 (分数 >= 90) { 返回 "优秀" }
    否则如果 (分数 >= 60) { 返回 "及格" }
    否则 { 返回 "不及格" }
}
断言等于(评级(95), "优秀", "第一档")
断言等于(评级(90), "优秀", "边界值走第一档")
断言等于(评级(75), "及格", "第二档")
断言等于(评级(60), "及格", "边界值走第二档")
断言等于(评级(59), "不及格", "否则分支")
断言等于(评级(0), "不及格", "最小值")

# ---- 嵌套分支 ----
函数 分类(数) {
    如果 (数 > 0) {
        如果 (数 % 2 == 0) { 返回 "正偶数" }
        否则 { 返回 "正奇数" }
    } 否则 {
        如果 (数 == 0) { 返回 "零" }
        否则 { 返回 "负数" }
    }
}
断言等于(分类(4), "正偶数", "嵌套：正偶数")
断言等于(分类(3), "正奇数", "嵌套：正奇数")
断言等于(分类(0), "零", "嵌套：零")
断言等于(分类(-1), "负数", "嵌套：负数")

# ---- 条件可以是任意表达式 ----
断言(1 < 2, "条件是比较表达式")
断言(真 且 假 或 真, "条件是逻辑表达式")
断言(长度([1, 2]) == 2, "条件里可以调用函数")

# ---- 真值判断：只有 假 与 空 为假 ----
设 计数 = 0
如果 (0) { 计数 = 计数 + 1 }
如果 ("") { 计数 = 计数 + 1 }
如果 ([]) { 计数 = 计数 + 1 }
断言等于(计数, 3, "数字零、空串、空数组都为真")

计数 = 0
如果 (假) { 计数 = 计数 + 1 }
如果 (空) { 计数 = 计数 + 1 }
断言等于(计数, 0, "只有 假 与 空 为假")

