# Willen 语言自举的测试断言库
#
# 由 willen test 在运行每个测试文件之前自动加载，测试脚本无需手动引入。
# 断言失败时立即打印详情并计数，测试脚本末尾调用 测试汇总() 输出统计。
#
# 这个文件本身用 Willen 语言编写——测试基础设施用被测试的语言实现，
# 是语言表达能力的直接证明。

设 断言总数 = 0
设 失败总数 = 0

# 断言条件为真
函数 断言(条件, 描述) {
    断言总数 = 断言总数 + 1
    如果 (非 条件) {
        失败总数 = 失败总数 + 1
        打印("  断言失败：{描述}")
    }
}

# 断言两个值相等。数组与结构体按内容递归比较（语言层面的深度比较）。
函数 断言等于(实际, 期望, 描述) {
    断言总数 = 断言总数 + 1
    如果 (实际 != 期望) {
        失败总数 = 失败总数 + 1
        打印("  断言失败：{描述}")
        打印("    期望：{期望}")
        打印("    实际：{实际}")
    }
}

# 断言两个值不相等
函数 断言不等(实际, 期望, 描述) {
    断言总数 = 断言总数 + 1
    如果 (实际 == 期望) {
        失败总数 = 失败总数 + 1
        打印("  断言失败：{描述}")
        打印("    两者不应相等，却都是：{实际}")
    }
}

# 在测试脚本末尾调用，输出统计
函数 测试汇总() {
    如果 (失败总数 == 0) {
        打印("全部 {断言总数} 个断言通过")
    } 否则 {
        打印("{断言总数} 个断言中 {失败总数} 个失败")
    }
}
