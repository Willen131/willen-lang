# 04 数组

# ---- 字面量与索引 ----
设 数列 = [10, 20, 30]
断言等于(数列[0], 10, "取第一个元素")
断言等于(数列[2], 30, "取最后一个元素")
断言等于(长度(数列), 3, "数组长度")
断言等于([], [], "空数组字面量")
断言等于(长度([]), 0, "空数组长度")

# ---- 索引赋值 ----
设 可变 = [1, 2, 3]
可变[1] = 99
断言等于(可变, [1, 99, 3], "按下标赋值")

# ---- 追加 / 插入 / 删除 ----
设 甲 = [1, 2]
甲.追加(3)
断言等于(甲, [1, 2, 3], "追加元素")
甲.插入(0, 0)
断言等于(甲, [0, 1, 2, 3], "在开头插入")
甲.插入(4, 4)
断言等于(甲, [0, 1, 2, 3, 4], "在末尾插入")
甲.删除(0)
断言等于(甲, [1, 2, 3, 4], "删除首元素")

# ---- 弹 ----
设 乙 = [1, 2, 3]
断言等于(乙.弹(), 3, "弹出并返回末元素")
断言等于(乙, [1, 2], "弹出后数组变短")

# ---- 包含 / 查找 ----
设 丙 = ["甲", "乙", "丙"]
断言(丙.包含("乙"), "包含判断为真")
断言(非 丙.包含("丁"), "不包含判断为假")
断言等于(丙.查找("丙"), 2, "查找返回下标")
断言等于(丙.查找("丁"), -1, "找不到返回 -1")

# ---- 反转 / 排序 ----
设 丁 = [3, 1, 2]
丁.反转()
断言等于(丁, [2, 1, 3], "反转")
丁.排序()
断言等于(丁, [1, 2, 3], "数字排序")
设 戊 = ["banana", "apple", "cherry"]
戊.排序()
断言等于(戊, ["apple", "banana", "cherry"], "字符串排序")

# ---- 连接 ----
断言等于([1, 2, 3].连接("-"), "1-2-3", "连接成字符串")
断言等于([].连接(","), "", "空数组连接得空串")

# ---- 切片（左闭右开）----
设 己 = [0, 1, 2, 3, 4]
断言等于(己.切片(1, 3), [1, 2], "取中间片段")
断言等于(己.切片(0, 0), [], "空切片")
断言等于(己.切片(0, 5), [0, 1, 2, 3, 4], "取全部")
断言等于(己, [0, 1, 2, 3, 4], "切片不改变原数组")

# ---- 二维数组 ----
设 网格 = [[1, 2], [3, 4]]
断言等于(网格[0][1], 2, "二维数组索引")
断言等于(网格[1], [3, 4], "取二维数组的一行")
网格[1][0] = 99
断言等于(网格, [[1, 2], [99, 4]], "修改二维数组元素")

# ---- 嵌套与混合类型 ----
断言等于([1, "甲", 真], [1, "甲", 真], "混合类型数组")
断言等于([[1], [2]], [[1], [2]], "嵌套数组深度比较")

# ---- 引用语义 ----
设 原始 = [1, 2]
设 别名 = 原始
别名.追加(3)
断言等于(原始, [1, 2, 3], "赋值共享同一底层对象")

测试汇总()
