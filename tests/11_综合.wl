# ---- 冒泡排序 ----
函数 冒泡排序(数列) {
    设 结果 = 数列.切片(0, 长度(数列))
    设 轮 = 0
    当 (轮 < 长度(结果) - 1) {
        设 位 = 0
        当 (位 < 长度(结果) - 1 - 轮) {
            如果 (结果[位] > 结果[位+1]) {
                设 暂 = 结果[位]
                结果[位] = 结果[位+1]
                结果[位+1] = 暂
            }
            位 = 位 + 1
        }
        轮 = 轮 + 1
    }
    返回 结果
}
断言等于(冒泡排序([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9], "乱序数组排序")
断言等于(冒泡排序([]), [], "空数组排序")
断言等于(冒泡排序([1]), [1], "单元素数组排序")
断言等于(冒泡排序([3, 2, 1]), [1, 2, 3], "逆序数组排序")

# ---- 二分查找 ----
函数 二分查找(数列, 目标) {
    设 低 = 0
    设 高 = 长度(数列) - 1
    当 (低 <= 高) {
        设 中 = (低 + 高) / 2
        如果 (数列[中] == 目标) { 返回 中 }
        如果 (数列[中] < 目标) { 低 = 中 + 1 }
        否则 { 高 = 中 - 1 }
    }
    返回 -1
}
设 有序 = [1, 3, 5, 7, 9, 11]
断言等于(二分查找(有序, 1), 0, "查找首元素")
断言等于(二分查找(有序, 11), 5, "查找末元素")
断言等于(二分查找(有序, 7), 3, "查找中间元素")
断言等于(二分查找(有序, 4), -1, "查找不存在的元素")

# ---- 矩阵相乘 ----
函数 矩阵相乘(甲, 乙) {
    设 结果 = []
    遍历 (行 在 0..长度(甲) - 1) {
        设 新行 = []
        遍历 (列 在 0..长度(乙[0]) - 1) {
            设 累计 = 0
            遍历 (内 在 0..长度(乙) - 1) {
                累计 = 累计 + 甲[行][内] * 乙[内][列]
            }
            新行.追加(累计)
        }
        结果.追加(新行)
    }
    返回 结果
}
设 甲矩阵 = [[1, 2], [3, 4]]
设 乙矩阵 = [[5, 6], [7, 8]]
断言等于(矩阵相乘(甲矩阵, 乙矩阵), [[19, 22], [43, 50]], "2x2 矩阵相乘")
设 单位阵 = [[1, 0], [0, 1]]
断言等于(矩阵相乘(甲矩阵, 单位阵), 甲矩阵, "乘以单位阵结果不变")

# ---- 学生成绩统计 ----
结构 学生 { 姓名, 成绩 }
设 学生表 = [
    学生{姓名: "甲", 成绩: 85},
    学生{姓名: "乙", 成绩: 92},
    学生{姓名: "丙", 成绩: 78}
]
函数 平均分(表) {
    设 总 = 0
    遍历 (人 在 表) { 总 = 总 + 人.成绩 }
    返回 总 / 长度(表)
}
断言等于(平均分(学生表), 85, "平均分")
函数 最高分(表) {
    设 最高 = 表[0].成绩
    遍历 (人 在 表) {
        如果 (人.成绩 > 最高) { 最高 = 人.成绩 }
    }
    返回 最高
}
断言等于(最高分(学生表), 92, "最高分")

# ---- 词频统计 ----
函数 词频(词表) {
    设 统计 = []
    遍历 (词 在 词表) {
        设 已见 = 假
        遍历 (项 在 统计) {
            如果 (项[0] == 词) {
                项[1] = 项[1] + 1
                已见 = 真
                跳出
            }
        }
        如果 (非 已见) { 统计.追加([词, 1]) }
    }
    返回 统计
}
设 词表 = ["甲", "乙", "甲", "丙", "甲"]
设 统计结果 = 词频(词表)
断言等于(长度(统计结果), 3, "统计出 3 个不同的词")
断言等于(统计结果[0], ["甲", 3], "甲 出现 3 次")
断言等于(统计结果[1], ["乙", 1], "乙 出现 1 次")

# ---- 素数筛 ----
函数 是否素数(数) {
    如果 (数 < 2) { 返回 假 }
    设 因子 = 2
    当 (因子 * 因子 <= 数) {
        如果 (数 % 因子 == 0) { 返回 假 }
        因子 = 因子 + 1
    }
    返回 真
}
函数 素数表(上界) {
    设 结果 = []
    遍历 (数 在 2..上界) {
        如果 (是否素数(数)) { 结果.追加(数) }
    }
    返回 结果
}
断言等于(素数表(20), [2, 3, 5, 7, 11, 13, 17, 19], "20 以内的素数")

