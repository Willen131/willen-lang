# 10 内置函数
#
# 说明：这里不测 打印 的输出内容——它的输出会混进标准输出，
# 破坏「整个文件输出与 .expected 比对」的机制。打印 的功能在其余
# 所有测试的间接使用中已经得到验证。

# ---- 长度 ----
断言等于(长度("abc"), 3, "字符串长度")
断言等于(长度([1, 2, 3, 4]), 4, "数组长度")

# ---- 类型转换 ----
断言等于(整数("42"), 42, "字符串转整数")
断言等于(整数(3.9), 3, "小数转整数时截断")
断言等于(整数(7), 7, "整数转整数不变")
断言等于(小数("3.14"), 3.14, "字符串转小数")
断言等于(小数(2), 2.0, "整数转小数")
断言等于(字符串(42), "42", "整数转字符串")
断言等于(字符串(3.5), "3.5", "小数转字符串")
断言等于(字符串(真), "真", "布尔转字符串")
断言等于(字符串([1, 2]), "[1, 2]", "数组转字符串")

# ---- 类型 ----
断言等于(类型(1), "整数", "整数")
断言等于(类型(1.5), "小数", "小数")
断言等于(类型("甲"), "字符串", "字符串")
断言等于(类型(真), "布尔", "布尔")
断言等于(类型(空), "空", "空")
断言等于(类型([1]), "数组", "数组")

# ---- 随机数 ----
设 甲 = 随机数()
断言(甲 >= 0 且 甲 <= 99, "随机数默认落在 0..99")

设 乙 = 随机数(10)
断言(乙 >= 0 且 乙 <= 10, "随机数单参数指定上界")

设 丙 = 随机数(5, 5)
断言等于(丙, 5, "上下界相同时必得该值")

设 都在范围内 = 真
遍历 (轮 在 1..30) {
    设 值 = 随机数(1, 6)
    如果 (值 < 1 或 值 > 6) { 都在范围内 = 假 }
}
断言(都在范围内, "30 次随机数都落在指定区间")

# ---- 时间 ----
断言(时间() > 0, "时间 返回正的毫秒时间戳")
断言(时间() >= 时间() - 1000, "两次取时间不会倒退")

测试汇总()
