# 07 循环

# ---- 当 ----
设 计数 = 0
当 (计数 < 5) { 计数 = 计数 + 1 }
断言等于(计数, 5, "当 循环基本用法")

计数 = 0
当 (假) { 计数 = 计数 + 1 }
断言等于(计数, 0, "条件一开始就为假则不执行")

计数 = 0
当 (计数 < 3) {
    计数 = 计数 + 1
    如果 (计数 == 2) { 继续 }
}
断言等于(计数, 3, "继续 不影响计数递增")

# ---- 遍历：范围 ----
设 累计 = 0
遍历 (元 在 0..4) { 累计 = 累计 + 元 }
断言等于(累计, 10, "遍历范围累加")

设 次数 = 0
遍历 (元 在 0..0) { 次数 = 次数 + 1 }
断言等于(次数, 1, "单元素范围循环一次")

次数 = 0
遍历 (元 在 3..1) { 次数 = 次数 + 1 }
断言等于(次数, 0, "空范围不循环")

# ---- 遍历：数组与字符串 ----
设 收集 = []
遍历 (元 在 [10, 20, 30]) { 收集.追加(元) }
断言等于(收集, [10, 20, 30], "遍历数组")

设 拼接 = ""
遍历 (字 在 "abc") { 拼接 = 拼接 + 字 }
断言等于(拼接, "abc", "遍历字符串")

# ---- 遍历使用快照 ----
设 源 = [1, 2, 3]
设 见到 = []
遍历 (元 在 源) {
    见到.追加(元)
    源.追加(99)
}
断言等于(见到, [1, 2, 3], "遍历使用快照，循环中改原数组不影响迭代")

# ---- 重复 N 次 ----
设 星 = ""
重复 4 次 { 星 = 星 + "*" }
断言等于(星, "****", "重复 4 次")

星 = ""
重复 0 次 { 星 = 星 + "*" }
断言等于(星, "", "重复 0 次不执行")

# ---- 跳出 ----
设 找到 = 0
遍历 (元 在 0..9) {
    如果 (元 == 4) { 跳出 }
    找到 = 找到 + 1
}
断言等于(找到, 4, "跳出 提前结束循环")

设 轮次 = 0
当 (真) {
    轮次 = 轮次 + 1
    如果 (轮次 >= 3) { 跳出 }
}
断言等于(轮次, 3, "当 循环里用 跳出 结束")

# ---- 继续 ----
设 偶数和 = 0
遍历 (元 在 0..9) {
    如果 (元 % 2 != 0) { 继续 }
    偶数和 = 偶数和 + 元
}
断言等于(偶数和, 20, "继续 跳过奇数")

# ---- 嵌套循环 ----
设 对数 = 0
遍历 (甲 在 1..3) {
    遍历 (乙 在 1..3) {
        对数 = 对数 + 1
    }
}
断言等于(对数, 9, "两层嵌套各循环 3 次")

# ---- 嵌套中的跳出只结束内层 ----
设 内层轮次 = 0
设 外层轮次 = 0
遍历 (甲 在 1..3) {
    外层轮次 = 外层轮次 + 1
    遍历 (乙 在 1..3) {
        内层轮次 = 内层轮次 + 1
        跳出
    }
}
断言等于(外层轮次, 3, "内层跳出不影响外层")
断言等于(内层轮次, 3, "内层每轮只执行一次就被跳出")

