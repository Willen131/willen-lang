# 02 运算符

# ---- 算术 ----
断言等于(2 + 3, 5, "加法")
断言等于(10 - 4, 6, "减法")
断言等于(3 * 4, 12, "乘法")
断言等于(20 / 5, 4, "整除")
断言等于(7 % 3, 1, "取模")
断言等于(-5, 0 - 5, "一元负号")
断言等于(- -5, 5, "双重负号")
断言等于(2 + 3 * 4, 14, "乘法优先于加法")
断言等于((2 + 3) * 4, 20, "括号改变优先级")
断言等于(10 - 3 - 2, 5, "减法左结合")
断言等于(100 / 10 / 2, 5, "除法左结合")

# ---- 整数与小数的类型提升 ----
断言等于(1 + 2, 3, "整数相加仍是整数")
断言等于(类型(1 + 2), "整数", "整数运算的类型")
断言等于(1 + 0.5, 1.5, "整数与小数相加得小数")
断言等于(类型(1 + 0.5), "小数", "混合运算提升为小数")
断言等于(7.0 / 2, 3.5, "小数除法")
断言等于(类型(1.5 * 3), "小数", "小数乘法")

# ---- 比较 ----
断言(3 > 2, "大于")
断言(2 < 3, "小于")
断言(3 >= 3, "大于等于")
断言(3 <= 3, "小于等于")
断言(3 == 3, "相等")
断言(3 != 4, "不等")
断言(1 == 1.0, "整数与小数可比较")
断言(1.5 > 1, "小数与整数可比较")

# ---- 逻辑与短路求值 ----
断言(真 且 真, "且")
断言(假 或 真, "或")
断言(非 假, "非")
断言(真 且 假 == 假, "且 的优先级低于 ==")
断言等于(假 且 未定义变量 == 1, 假, "且 短路：右侧不求值")
断言等于(真 或 未定义变量 == 1, 真, "或 短路：右侧不求值")

# ---- 字符串拼接 ----
断言等于("甲" + "乙", "甲乙", "字符串拼接")
断言等于("数字：" + 42, "数字：42", "字符串与数字拼接")
断言等于(42 + "号", "42号", "数字与字符串拼接")
断言等于("值=" + 1.5, "值=1.5", "字符串与小数拼接")

# ---- 复合赋值 ----
设 甲 = 10
甲 += 5
断言等于(甲, 15, "+= 复合赋值")
甲 -= 3
断言等于(甲, 12, "-= 复合赋值")
甲 *= 2
断言等于(甲, 24, "*= 复合赋值")
甲 /= 4
断言等于(甲, 6, "/= 复合赋值")

# ---- 范围 ----
断言等于(0..4, [0, 1, 2, 3, 4], "范围生成数组")
断言等于(长度(0..0), 1, "单元素范围")
断言等于(长度(3..1), 0, "逆序范围为空")

测试汇总()
