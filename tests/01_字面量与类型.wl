# 01 字面量与类型

# ---- 整数 ----
断言等于(42, 42, "整数字面量")
断言等于(-7, 0 - 7, "负数由一元负号构成")
断言等于(0, 0, "零")

# ---- 小数 ----
断言等于(3.14, 3.14, "小数字面量")
断言等于(1.5 + 1.5, 3.0, "小数相加")

# ---- 字符串 ----
断言等于("你好", "你好", "中文字符串")
断言等于("abc", "abc", "英文字符串")
断言等于("", "", "空字符串")
断言等于("行1\n行2", "行1\n行2", "转义换行")
断言等于("引号\"", "引号\"", "转义引号")

# ---- 布尔与空 ----
断言(真, "真 为真")
断言(非 假, "假 取非为真")
断言等于(类型(空), "空", "空 的类型")

# ---- 类型判断 ----
断言等于(类型(42), "整数", "整数的类型")
断言等于(类型(3.14), "小数", "小数的类型")
断言等于(类型("甲"), "字符串", "字符串的类型")
断言等于(类型(真), "布尔", "布尔的类型")
断言等于(类型([1]), "数组", "数组的类型")

