# 08 函数

# ---- 定义与调用 ----
函数 无参() { 返回 42 }
断言等于(无参(), 42, "无参函数")

函数 加一(甲) { 返回 甲 + 1 }
断言等于(加一(5), 6, "单参函数")

函数 求和(甲, 乙) { 返回 甲 + 乙 }
断言等于(求和(3, 4), 7, "双参函数")

函数 三参(甲, 乙, 丙) { 返回 甲 + 乙 + 丙 }
断言等于(三参(1, 2, 3), 6, "三参函数")

# ---- 无返回值 ----
函数 无返回语句(甲) { 设 局部 = 甲 }
断言等于(无返回语句(1), 空, "没有返回语句的函数返回空")

函数 裸返回() { 返回 }
断言等于(裸返回(), 空, "裸返回得到空")

# ---- 提前返回 ----
函数 取绝对值(甲) {
    如果 (甲 < 0) { 返回 -甲 }
    返回 甲
}
断言等于(取绝对值(-5), 5, "负数取绝对值")
断言等于(取绝对值(5), 5, "正数取绝对值")
断言等于(取绝对值(0), 0, "零取绝对值")

# ---- 返回值可以是任意类型 ----
函数 造数组() { 返回 [1, 2, 3] }
断言等于(造数组(), [1, 2, 3], "返回数组")

结构 点 { 横, 纵 }
函数 造点(甲, 乙) { 返回 点{横: 甲, 纵: 乙} }
断言等于(造点(1, 2), 点{横: 1, 纵: 2}, "返回结构体")

函数 造字符串() { 返回 "你好" }
断言等于(造字符串(), "你好", "返回字符串")

# ---- 基本类型参数按值传递 ----
函数 试图修改(甲) { 甲 = 999 }
设 原值 = 1
试图修改(原值)
断言等于(原值, 1, "基本类型参数按值传递，函数内修改不影响调用方")

# ---- 数组参数是引用语义 ----
函数 追加元素(数列) { 数列.追加(99) }
设 数据 = [1, 2]
追加元素(数据)
断言等于(数据, [1, 2, 99], "数组参数与调用方共享底层对象")

# ---- 作用域隔离 ----
设 全局甲 = "全局"
函数 遮蔽() {
    设 全局甲 = "局部"
    返回 全局甲
}
断言等于(遮蔽(), "局部", "函数内定义同名变量遮蔽全局")
断言等于(全局甲, "全局", "函数内的定义不影响全局")

函数 读全局() { 返回 全局甲 }
断言等于(读全局(), "全局", "函数能读到全局变量")

函数 写全局() { 全局甲 = "被改了" }
写全局()
断言等于(全局甲, "被改了", "函数能给全局变量赋值")

# ---- 函数调用函数 ----
函数 平方(甲) { 返回 甲 * 甲 }
函数 平方和(甲, 乙) { 返回 平方(甲) + 平方(乙) }
断言等于(平方和(3, 4), 25, "函数体内调用另一个函数")

# ---- 实参求值顺序 ----
设 顺序 = []
函数 记录(标号) {
    顺序.追加(标号)
    返回 标号
}
函数 三参记录(甲, 乙, 丙) { 返回 甲 + 乙 + 丙 }
三参记录(记录(1), 记录(2), 记录(3))
断言等于(顺序, [1, 2, 3], "实参从左到右求值")

测试汇总()
