# 09 递归

# ---- 阶乘 ----
函数 阶乘(甲) {
    如果 (甲 <= 1) { 返回 1 }
    返回 甲 * 阶乘(甲-1)
}
断言等于(阶乘(0), 1, "0 的阶乘")
断言等于(阶乘(1), 1, "1 的阶乘")
断言等于(阶乘(5), 120, "5 的阶乘")
断言等于(阶乘(10), 3628800, "10 的阶乘")

# ---- 斐波那契 ----
函数 斐波那契(甲) {
    如果 (甲 < 2) { 返回 甲 }
    返回 斐波那契(甲-1) + 斐波那契(甲-2)
}
断言等于(斐波那契(0), 0, "第 0 项")
断言等于(斐波那契(1), 1, "第 1 项")
断言等于(斐波那契(10), 55, "第 10 项")
断言等于(斐波那契(20), 6765, "第 20 项")

# ---- 最大公约数（辗转相除）----
函数 最大公约数(甲, 乙) {
    如果 (乙 == 0) { 返回 甲 }
    返回 最大公约数(乙, 甲 % 乙)
}
断言等于(最大公约数(12, 8), 4, "12 与 8")
断言等于(最大公约数(100, 75), 25, "100 与 75")
断言等于(最大公约数(7, 13), 1, "互质")

# ---- 汉诺塔步数 ----
函数 汉诺塔步数(层数) {
    如果 (层数 == 0) { 返回 0 }
    返回 汉诺塔步数(层数-1) * 2 + 1
}
断言等于(汉诺塔步数(1), 1, "1 层需要 1 步")
断言等于(汉诺塔步数(3), 7, "3 层需要 7 步")
断言等于(汉诺塔步数(10), 1023, "10 层需要 1023 步")

# ---- 递归处理数组 ----
函数 递归求和(数列) {
    如果 (长度(数列) == 0) { 返回 0 }
    返回 数列[0] + 递归求和(数列.切片(1, 长度(数列)))
}
断言等于(递归求和([1, 2, 3, 4]), 10, "递归求和")

# ---- 与迭代版结果一致 ----
函数 阶乘迭代(甲) {
    设 结果 = 1
    设 当前 = 2
    当 (当前 <= 甲) {
        结果 = 结果 * 当前
        当前 = 当前 + 1
    }
    返回 结果
}
断言等于(阶乘迭代(10), 阶乘(10), "迭代版与递归版结果一致")

# ---- 深递归（在 200 层上限之内）----
函数 数到零(甲) {
    如果 (甲 == 0) { 返回 0 }
    返回 数到零(甲-1) + 1
}
断言等于(数到零(150), 150, "150 层递归正常返回")

