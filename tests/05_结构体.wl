# 05 结构体

结构 点 { 横, 纵 }
结构 线段 { 起点, 终点 }
结构 空结构 { }

# ---- 构造与字段访问 ----
设 甲 = 点{横: 3, 纵: 4}
断言等于(甲.横, 3, "读取横坐标")
断言等于(甲.纵, 4, "读取纵坐标")

# ---- 字段赋值 ----
甲.横 = 10
断言等于(甲.横, 10, "修改字段")
断言等于(甲, 点{横: 10, 纵: 4}, "修改后整体相等")

# ---- 未提供的字段默认为空 ----
设 乙 = 点{横: 1}
断言等于(乙.纵, 空, "未提供的字段默认为空")

# ---- 类型与相等 ----
断言等于(类型(甲), "结构体", "结构体的类型")
断言(甲 == 点{横: 10, 纵: 4}, "同类型同内容相等")
断言(非 (甲 == 点{横: 10, 纵: 5}), "内容不同则不等")

# ---- 嵌套结构体 ----
设 丙 = 线段{起点: 点{横: 0, 纵: 0}, 终点: 点{横: 3, 纵: 4}}
断言等于(丙.起点.横, 0, "读取嵌套字段")
断言等于(丙.终点.纵, 4, "读取另一端的嵌套字段")
丙.终点.横 = 10
断言等于(丙.终点.横, 10, "修改嵌套字段")

# ---- 结构体数组 ----
设 顶点表 = [点{横: 1, 纵: 1}, 点{横: 2, 纵: 2}]
断言等于(长度(顶点表), 2, "结构体数组长度")
断言等于(顶点表[1].横, 2, "取结构体数组元素的字段")
顶点表[0].纵 = 9
断言等于(顶点表[0].纵, 9, "通过数组修改结构体字段")

# ---- 作为函数参数（引用语义）----
函数 平移(目标, 增量) {
    目标.横 = 目标.横 + 增量
    目标.纵 = 目标.纵 + 增量
}
设 丁 = 点{横: 0, 纵: 0}
平移(丁, 5)
断言等于(丁, 点{横: 5, 纵: 5}, "函数内修改结构体影响调用方")

# ---- 空结构 ----
设 戊 = 空结构{}
断言等于(类型(戊), "结构体", "空结构也能构造")

测试汇总()
