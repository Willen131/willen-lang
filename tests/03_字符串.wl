# 03 字符串

# ---- 长度（按字节计）----
断言等于(长度("abc"), 3, "英文字符串长度")
断言等于(长度("你好"), 6, "中文字符串长度按字节计")
断言等于(长度(""), 0, "空字符串长度")

# ---- 大小写 ----
断言等于("Hello".大写(), "HELLO", "转大写")
断言等于("Hello".小写(), "hello", "转小写")
断言等于("aBc".大写(), "ABC", "混合大小写转大写")

# ---- 子串（左闭右开）----
断言等于("Hello".子串(0, 2), "He", "取前两个字符")
断言等于("Hello".子串(2, 5), "llo", "取到结尾")
断言等于("Hello".子串(0, 0), "", "空子串")
断言等于("Hello".子串(0, 5), "Hello", "取整个字符串")

# ---- 查找 ----
断言等于("Hello".查找("l"), 2, "查找首个匹配位置")
断言等于("Hello".查找("z"), -1, "找不到返回 -1")
断言等于("Hello".查找("lo"), 3, "查找子串")

# ---- 替换 ----
断言等于("Hello".替换("l", "L"), "HeLLo", "替换全部匹配")
断言等于("aaa".替换("aa", "b"), "ba", "从左到右替换且不重叠")
断言等于("abc".替换("z", "y"), "abc", "无可替换时原样返回")

# ---- 分割 ----
断言等于("a,b,c".分割(","), ["a", "b", "c"], "按逗号分割")
断言等于("a".分割(","), ["a"], "无分隔符时返回单元素")
断言等于("".分割(","), [""], "空串分割得一个空元素")

# ---- 去空白 ----
断言等于("  中间 空格  ".去空白(), "中间 空格", "去掉首尾空白")
断言等于("abc".去空白(), "abc", "无空白时原样返回")

# ---- 包含 ----
断言("Hello".包含("ell"), "包含子串")
断言(非 "Hello".包含("xyz"), "不包含时返回假")

# ---- 字符 ----
断言等于("abc".字符(1), "b", "按下标取字符")

# ---- 模板字符串 ----
设 名字 = "Willen"
断言等于("你好，{名字}！", "你好，Willen！", "模板插值")
断言等于("{1 + 2}", "3", "模板里可以放表达式")
断言等于("{{字面}}", "\{字面\}", "双花括号折叠为字面花括号（右侧用转义写法）")
断言等于("共 {长度("abc")} 个", "共 3 个", "模板里嵌套函数调用")

测试汇总()
